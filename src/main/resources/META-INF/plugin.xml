<!-- Plugin Configuration File: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Unique identifier of the plugin. It should be FQN, cannot be changed between the plugin versions. -->
    <id>com.github.intellij.plugins.github_copilot_quota_monitor.github-copilot-premium-quota-monitor-for-ij</id>

    <!-- Public plugin name should be written in Title Case.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-name -->
    <name>GitHub Copilot Premium Quota Monitor</name>

    <!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
    <vendor url="https://github.com/antonio-petricca/github-copilot-premium-quota-monitor-for-ij">GitHub Copilot Premium Quota Monitor</vendor>

    <!-- Description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-description -->
    <description><![CDATA[
        Displays the remaining <b>GitHub Copilot premium AI-model quota</b> directly in the IDE status bar.<br/>
        The widget refreshes automatically every 5 minutes and on click.<br/>
        <br/>
        <b>First-time setup</b><br/>
        Right-click the quota widget in the status bar and select <em>Sign in with GitHub</em> to authorize the plugin via the standard GitHub
        OAuth Device Flow (RFC 8628). No external plugin is required.<br/>
        <br/>
        <b>Requirements</b><br/>
        <ul>
            <li>IntelliJ IDEA Community or Ultimate 2025.2 (build 252) or later.</li>
            <li>A GitHub account with an active Copilot subscription.</li>
        </ul>
    ]]></description>

    <!-- Only the IntelliJ Platform base module is required.
         This makes the plugin compatible with all IntelliJ-based IDEs
         (IDEA Community, IDEA Ultimate, PyCharm, WebStorm, GoLand, …). -->
    <depends>com.intellij.modules.platform</depends>

    <!-- Extensions defined by the plugin.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
    <extensions defaultExtensionNs="com.intellij">

        <!-- Authentication service: OAuth Device Flow + PasswordSafe token store -->
        <applicationService
            serviceImplementation="com.github.intellij.plugins.github_copilot_quota_monitor.services.AuthService"/>

        <!-- Quota service: fetches and caches quota data -->
        <applicationService
            serviceImplementation="com.github.intellij.plugins.github_copilot_quota_monitor.services.Service"/>

        <!-- Status bar widget factory -->
        <statusBarWidgetFactory
            id="GitHubCopilotQuotaWidget"
            implementation="com.github.intellij.plugins.github_copilot_quota_monitor.statusbar.StatusBarWidgetFactory"
            order="first"/>

        <!-- Startup activity: shows sign-in dialog on first run if not authenticated -->
        <projectActivity
            implementation="com.github.intellij.plugins.github_copilot_quota_monitor.startup.SignInStartupActivity"/>

    </extensions>
</idea-plugin>